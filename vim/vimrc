" ### Toggle terminal emulator
" map <silent> <Leader>t :botright terminal<CR>
nnoremap <silent> <leader>t :call ToggleTerminal()<CR>

augroup TerminalAG
	autocmd!

	autocmd BufEnter,BufLeave *
		\ if &buftype == 'terminal' |
			\ execute 'resize' str2nr(split(&termwinsize, '\*')[0]) |
		\ endif

	autocmd TerminalOpen * call SetTerminalSettings()
augroup end

function! ToggleTerminal()
	let terminal_buffer = bufnr('!/usr/bin/bash')
	if terminal_buffer != -1
		let terminal_window = bufwinnr(terminal_buffer)
		if terminal_window != -1
			exec terminal_window 'hide'
		else
			exec 'botright sbuffer' terminal_buffer
		endif
	else
		botright terminal
	endif
endfunction

function! SetTerminalSettings()
	setlocal nonumber
endfunction

